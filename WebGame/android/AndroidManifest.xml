<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.operationzero.costadeferro" android:versionCode="12" android:versionName="0.12">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <application android:label="Operação Zero" android:icon="@drawable/ic_zero"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
        android:hardwareAccelerated="true" android:allowBackup="false"
        android:usesCleartextTraffic="false">
        <activity android:name=".GameActivity" android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
